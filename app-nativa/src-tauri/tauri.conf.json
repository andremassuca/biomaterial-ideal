{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biomaterial Ideal",
  "version": "1.1.0",
  "identifier": "pt.ulusofona.biomaterialideal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Biomaterial Ideal",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "André Oliveira Massuça",
    "copyright": "André Oliveira Massuça, Universidade Lusófona",
    "category": "Education",
    "shortDescription": "Ferramenta educativa de exploração de critérios na escolha de biomateriais",
    "longDescription": "Ferramenta educativa de exploração de critérios. Não é um dispositivo médico e não substitui a decisão clínica.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "pt-PT" },
      "nsis": { "languages": ["Portuguese"], "displayLanguageSelector": false }
    }
  }
}
