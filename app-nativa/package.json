{
  "name": "biomaterial-ideal",
  "private": true,
  "version": "1.1.0",
  "description": "Aplicação nativa Biomaterial Ideal (Tauri 2, React e TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "verificar": "tsc --noEmit",
    "tauri": "tauri",
    "wasm": "wasm-pack build crates/mcdm-wasm --release --target web --out-dir ../../src/wasm --no-pack",
    "build:web": "tsc --noEmit && vite build --base ./ --outDir dist-web",
    "test": "vitest run",
    "e2e": "playwright test",
    "video": "node e2e/video_demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-radio-group": "1.2.1",
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slider": "1.2.1",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-tooltip": "1.1.3",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@tauri-apps/api": "2.0.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "11.11.9",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "tailwind-merge": "2.5.4",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@tauri-apps/cli": "2.0.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.9"
  }
